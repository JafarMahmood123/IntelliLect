{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "SecretKey": "",
    "Issuer": "",
    "Audience": ""
  },
  "ClassroomService": {
    "BaseUrl": "http://classroom-service:8080",
    "InternalApiSecret": "",
    "TimeoutSeconds": 10
  },
  "StreamingService": {
    "BaseUrl": "http://streaming-service:8080"
  },
  "LiveAssistant": {
    "BaseUrl": "http://live-assistant-service:8080",
    "InternalApiSecret": ""
  },
  "KnowledgeService": {
    "BaseUrl": "http://knowledge-service:8080",
    "InternalApiSecret": "",
    "TimeoutSeconds": 10
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  }
}
