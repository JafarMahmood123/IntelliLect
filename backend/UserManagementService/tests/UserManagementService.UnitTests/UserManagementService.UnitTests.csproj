<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <!-- Pinned to match Infrastructure's. MigrationConformanceTests compares the model against
         the migration snapshot through the Npgsql provider — the same provider the snapshot was
         generated for, because comparing against another reports differences that are only
         differences of provider. Without this the test project resolves an older EF than
         Infrastructure was built against and will not compile. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.5" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\UserManagementService.Application\UserManagementService.Application.csproj" />
    <ProjectReference Include="..\..\src\UserManagementService.Domain\UserManagementService.Domain.csproj" />
    <!-- The composition root: a fallback reintroduced there is what these tests catch. -->
    <ProjectReference Include="..\..\src\UserManagementService.Infrastructure\UserManagementService.Infrastructure.csproj" />
    <!-- GlobalExceptionHandler lives here, and it decides what EVERY endpoint returns when
         something throws — including what a client that timed out and retried is told. -->
    <ProjectReference Include="..\..\src\UserManagementService.Api\UserManagementService.Api.csproj" />
  </ItemGroup>

</Project>