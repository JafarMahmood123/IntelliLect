<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <!-- Pinned above what EF drags in: 2.1.11 bundles a vulnerable SQLite
         (GHSA-2m69-gcr7-jv3q). Test-only — this database never ships. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ClassroomService.Application\ClassroomService.Application.csproj" />
    <ProjectReference Include="..\..\src\ClassroomService.Infrastructure\ClassroomService.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\ClassroomService.Domain\ClassroomService.Domain.csproj" />
    <!-- Controllers and filters: authorization is declared there, so it is tested there. -->
    <ProjectReference Include="..\..\src\ClassroomService.Presentation\ClassroomService.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
