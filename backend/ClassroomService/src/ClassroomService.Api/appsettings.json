{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": ""
  },
  "Jwt": {
    "SecretKey": "",
    "Issuer": "",
    "Audience": ""
  },
  "S3Settings": {
    "BucketName": "",
    "ServiceUrl": "",
    "Region": ""
  },
  "Recordings": {
    "DownloadUrlTtlSeconds": 600,
    "StuckProcessingMinutes": 30,
    "ReconcileEnabled": true,
    "ReconcileIntervalMinutes": 15,
    "RetentionDays": 0,
    "RetentionEnabled": false
  },
  "Summaries": {
    "DownloadUrlTtlSeconds": 600
  },
  "Uploads": {
    "MaxFileSizeBytes": 52428800,
    "MultipartOverheadBytes": 8192,
    "AllowedContentTypes": [
      "application/pdf",
      "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
      "application/vnd.openxmlformats-officedocument.presentationml.presentation",
      "text/plain",
      "text/markdown",
      "text/x-markdown"
    ],
    "AllowedExtensions": [ "pdf", "docx", "pptx", "txt", "md", "markdown" ]
  },
  "Sessions": {
    "StalledSweepEnabled": true,
    "StalledSweepIntervalMinutes": 60,
    "StalledAfterHours": 4,
    "StalledSweepBatchSize": 50
  },
  "StreamingService": {
    "BaseUrl": "http://streaming-service:8080",
    "TimeoutSeconds": 10
  },
  "RagService": {
    "BaseUrl": "http://rag-service:8080",
    "InternalApiSecret": "",
    "TimeoutSeconds": 10
  },
  "LiveAssistant": {
    "BaseUrl": "http://live-assistant-service:8080",
    "InternalApiSecret": "",
    "TimeoutSeconds": 10,
    "GenerationTimeoutSeconds": 120
  },
  "Internal": {
    "ApiSecret": ""
  }
}
