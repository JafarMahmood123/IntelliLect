# =============================================================================
# IntelliLect — root environment template
#
#   cp backend/.env.example backend/.env    then fill in the blanks
#
# Docker Compose loads backend/.env automatically and substitutes these into
# the compose files. EVERY value below is required: the compose files use the
# ${VAR:?...} form, so a missing one stops the stack immediately with a message
# naming the variable, rather than starting a service that fails later.
#
# NOTHING here is a real credential — every value is a placeholder. Never
# commit .env.
#
# Why this file matters: several of these are consumed by more than one service
# and MUST agree. The JWT key is read by three services, the broker credentials
# by four plus the broker itself, and the internal secret by five. They used to
# be written out separately in each compose unit, where nothing stopped two
# copies drifting apart — a mismatch that presents as every request being 401,
# or every internal call being refused, with no other symptom.
# =============================================================================

# --- Message broker ----------------------------------------------------------
# Consumed by the intellilect-mq container (RABBITMQ_DEFAULT_USER/PASS) and by
# all four .NET services (RabbitMq__Username/__Password). The services now
# refuse to start without them.
RABBITMQ_USER=change-me
RABBITMQ_PASS=change-me

# --- Databases ---------------------------------------------------------------
# One password shared by every service's Postgres instance and by the
# connection strings that reach them.
POSTGRES_PASSWORD=change-me

# --- Object storage (MinIO / S3) ---------------------------------------------
# Root credentials for the store holding recordings, summaries and classroom
# materials. Also used as the egress S3 credentials.
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me

# --- Token signing -----------------------------------------------------------
# Read by UserManagementService (which issues tokens), ClassroomService and
# StreamingService (which validate them). Any value works locally, but all
# three must agree — a mismatch presents as every request being 401 with no
# other symptom. Use a long random string.
JWT_SECRET_KEY=change-me-to-a-long-random-string

# --- LiveKit -----------------------------------------------------------------
# API credentials for minting join tokens and driving recording egress. Must
# match the keys configured on the LiveKit server itself, which runs outside
# this compose stack.
LIVEKIT_API_KEY=change-me
LIVEKIT_API_SECRET=change-me

# The LAN IP of the machine running LiveKit, used to build the WebRTC node
# address and the browser-facing ws:// URL.
#
# On Docker Desktop this MUST be 127.0.0.1 — host networking forwards UDP on
# loopback only, and a LAN IP here produces a session that connects and then
# carries no media. Set a real LAN IP only when a second machine must join.
# The one variable here with a default: it falls back to 127.0.0.1 if unset.
LIVEKIT_HOST_IP=127.0.0.1

# --- Internal service-to-service calls ---------------------------------------
# Shared secret on the /api/internal surface, read by five services. The guard
# fails closed, so a mismatch refuses every internal call — indexing stops,
# transcripts stop, quiz generation stops, with no error visible to the user.
INTERNAL_API_SECRET=change-me

# --- Outbound mail -----------------------------------------------------------
# The app password is a Google App Password, not the account password.
SMTP_SENDER_EMAIL=you@example.com
SMTP_APP_PASSWORD=change-me


# =============================================================================
# Service-specific settings live elsewhere, on purpose:
#
#   backend/RagService/.env.example     — embeddings, chunking, OCR, RAG
#   backend/LiveAssistantService/.env.example — STT, boundary detection, brain
#
# Both are loaded by their service through env_file. Non-secret per-service
# settings (base URLs, timeouts, feature toggles) stay inline in each
# docker-compose.unit.yml, where they are readable next to the service they
# configure.
# =============================================================================
