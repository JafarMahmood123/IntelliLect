# =============================================================================
# IntelliLect — root environment template
#
#   cp backend/.env.example backend/.env    then fill in the blanks
#
# Docker Compose loads backend/.env automatically and uses it for ${VAR}
# substitution in the compose files. NOTHING here is a real credential — every
# value below is a placeholder or a safe local default. Never commit .env.
#
# SCOPE, and it is narrower than it looks. Only a few variables are actually
# read from this file today; the rest of the stack's configuration is written
# inline in each service's docker-compose.unit.yml. Those inline values are
# listed at the bottom for reference, because that is where you have to change
# them — editing them here would do nothing. Moving them into env files is a
# separate, deliberate decision (see docs/work-plan.md §14.7).
# =============================================================================

# --- Actually read from this file (compose ${...} interpolation) -------------

# The LAN IP of the machine running LiveKit, used to build the WebRTC node
# address and the browser-facing ws:// URL.
#
# On Docker Desktop this MUST be 127.0.0.1 — host networking forwards UDP on
# loopback only, and a LAN IP here produces a session that connects and then
# carries no media. Set a real LAN IP only when a second machine must join.
# Defaults to 127.0.0.1 if unset.
LIVEKIT_HOST_IP=127.0.0.1


# --- Read from this file by the Python services -----------------------------
# KnowledgeService and LiveAssistantService also load their OWN .env (see
# env_file: in their compose units). Service-specific keys belong there —
# see backend/KnowledgeService/.env.example and
# backend/LiveAssistantService/.env.example.


# =============================================================================
# REFERENCE ONLY — currently set inline in docker-compose.unit.yml
#
# Listed so the full set of secrets is visible in one place. Changing them here
# has NO effect today; change them in the compose unit for the service.
# Every value shown is a placeholder.
# =============================================================================

# Message broker. Must match RABBITMQ_DEFAULT_USER/PASS on the intellilect-mq
# service. All four .NET services now REQUIRE these and refuse to start without
# them (RabbitMq__Username / RabbitMq__Password).
# RABBITMQ_USER=change-me
# RABBITMQ_PASS=change-me

# Postgres. One password is currently shared by every service database.
# POSTGRES_PASSWORD=change-me

# MinIO / S3. Root credentials for the object store holding recordings,
# summaries and classroom materials.
# MINIO_ROOT_USER=change-me
# MINIO_ROOT_PASSWORD=change-me

# JWT signing key, shared by every service that validates a token. Any value
# works locally, but all services must agree — a mismatch presents as every
# request being 401 with no other symptom.
# JWT_SECRET_KEY=change-me-to-a-long-random-string

# LiveKit server API credentials (minting join tokens, driving egress).
# LIVEKIT_API_KEY=change-me
# LIVEKIT_API_SECRET=change-me

# Shared secret on the /api/internal surface. Every service must use the SAME
# value; the guard fails closed, so a mismatch refuses every internal call.
# INTERNAL_API_SECRET=change-me

# SMTP for outbound mail. The app password is a Google App Password, not the
# account password.
# SMTP_SENDER_EMAIL=you@example.com
# SMTP_APP_PASSWORD=change-me
