# =============================================================================
# RagService (RAG) — environment template
#
#   cp .env.example .env    then fill in the blanks
#
# Loaded by compose (env_file:) AND by pydantic-settings when running the
# service directly. Case-insensitive; unknown keys are ignored, so this file
# can safely share a shell with its siblings.
#
# This lists what you must SET and what you are most likely to CHANGE. It is
# deliberately not a copy of every field — app/infrastructure/config/settings.py
# is the authoritative list, and it documents each value and why it holds that
# default far better than a duplicated list here could stay in step with.
#
# No real credentials. Never commit .env.
# =============================================================================

# --- REQUIRED: no default exists, the service will not start without it ------

# Async SQLAlchemy URL for the pgvector database.
DATABASE_URL=postgresql+asyncpg://postgres:change-me@knowledge-db:5432/knowledgedb

# Must match INTERNAL_API_SECRET / RagService__InternalApiSecret on every
# caller. The guard fails closed: without it, ingestion and search are refused.
INTERNAL_API_SECRET=changeme-internal-secret


# --- REQUIRED for the default providers --------------------------------------

# Embeddings and generation both default to Gemini.
GEMINI_API_KEY=

# Object store holding the uploaded classroom materials this service ingests.
S3_BUCKET_NAME=intellilect-files
S3_SERVICE_URL=http://intellilect-s3:9000
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_REGION=us-east-1


# --- Embeddings: change these together ---------------------------------------
# EMBEDDING_DIM must match what the model actually returns AND the pgvector
# column width. Changing the model therefore means a schema migration and
# re-embedding the entire stored corpus — a mismatch is not a degraded search,
# it is a hard failure at query time. The dimension guard exists to catch this.
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=3072


# --- Commonly changed --------------------------------------------------------

# ollama | gemini. Which model answers questions and writes summaries.
GENERATION_PROVIDER=gemini

# Chunking. structural follows document headings; semantic splits on embedding
# distance. CHUNK_MAX_TOKENS is a hard cap per chunk.
CHUNKING_STRATEGY=structural
CHUNK_MAX_TOKENS=512
CHUNK_OVERLAP_TOKENS=64

# Retrieval breadth. SEARCH_DEFAULT_TOP_K applies when a caller does not ask.
SEARCH_DEFAULT_TOP_K=8

# OCR language for scanned PDFs. Add "+ara" for Arabic documents — the Tesseract
# language pack must be installed in the image for this to take effect.
OCR_LANG=eng

LOG_LEVEL=INFO


# --- Everything else ---------------------------------------------------------
# OCR tuning, ingestion concurrency and retry/backoff, stale-job recovery, admin
# paging, bulk reindex limits, generation temperature and token budgets, summary
# models. All have working defaults.
# Read app/infrastructure/config/settings.py before changing any of them.
