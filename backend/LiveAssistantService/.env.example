# =============================================================================
# LiveAssistantService — environment template
#
#   cp .env.example .env    then fill in the blanks
#
# Loaded by compose (env_file:) AND by pydantic-settings when running the
# service directly. Case-insensitive; unknown keys are ignored, so this file
# can safely share a shell with its siblings.
#
# This lists what you must SET and what you are most likely to CHANGE. It is
# deliberately not a copy of every field — app/infrastructure/config/settings.py
# is the authoritative list, and it documents each value and why it holds that
# default far better than a duplicated list here could stay in step with.
#
# No real credentials. Never commit .env.
# =============================================================================

# --- REQUIRED: secrets with no safe default ---------------------------------

# Hosted STT. Required when STT_PROVIDER=groq (the default for live sessions).
# NOTE: Groq answers 403 from VPN and datacenter exit IPs, and separately blocks
# some countries outright. A 403 whose body says "Forbidden" is the network; one
# naming invalid_api_key is the key. See run-services.txt §1.
GROQ_API_KEY=

# Gemini, used for the boundary embedder and (when BRAIN_PROVIDER=gemini) for
# evaluation and quiz generation.
GEMINI_API_KEY=

# Must match INTERNAL_API_SECRET / Internal__ApiSecret on every other service.
# The guard fails closed: a mismatch refuses every internal call.
INTERNAL_API_SECRET=changeme-internal-secret


# --- Commonly changed --------------------------------------------------------

# groq (hosted, ~4.5x realtime) | faster_whisper (local CPU). No automatic
# fallback between them by design — a 20x-slower silent downgrade is harder to
# diagnose than a loud failure.
STT_PROVIDER=groq

# Spoken language. Empty means auto-detect, which is the right setting for a
# teacher who code-switches. "ar" forces Arabic.
# If you set a non-English language, blank STT_INITIAL_PROMPT too — it is
# English vocabulary and biases the decode.
STT_LANGUAGE=

# gemini | ollama. Which model evaluates ideas and writes quizzes.
BRAIN_PROVIDER=gemini

# Cosine-distance threshold at which a new sentence is treated as a new topic.
# Calibrated at 0.25 and measured to transfer unchanged across English, Arabic
# and French; same-meaning Arabic<->English pairs sit near 0.055, so a
# code-switching teacher does not trigger a false split.
BOUNDARY_DRIFT_THRESHOLD=0.25

# MUST be false for real feedback. When true the assistant bypasses the grounded
# evaluation prompt entirely and simply comments on the transcript — which looks
# like it is working while checking nothing.
ASSISTANT_SMOKE_TEST=false


# --- Everything else ---------------------------------------------------------
# LiveKit connection, audio normalisation, VAD tuning, beam size, thread counts,
# pacing, retrieval, transcript persistence, timeouts. All have working defaults
# and are set in docker-compose.unit.yml where they differ.
# Read app/infrastructure/config/settings.py before changing any of them — most
# carry a comment explaining what went wrong at the other value.
