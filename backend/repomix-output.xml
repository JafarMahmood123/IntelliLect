            _logger.LogInformation("Email successfully sent to {Email}", context.Message.Email);
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Failed to send email to {Email}. MassTransit will retry.", context.Message.Email);
            throw;
        }
    }
}
