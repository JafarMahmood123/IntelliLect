<file path="docker-compose.yml">
name: intellilect-platform

include:
  - path: ./UserManagementService/docker-compose.unit.yml

services:
  rabbitmq:
    image: rabbitmq:3-management-alpine
    container_name: intellilect-mq
    ports:
      - "5672:5672"
      - "15672:15672"
    healthcheck:
      test: [ "CMD", "rabbitmq-diagnostics", "check_running" ]
      interval: 5s
      timeout: 5s
      retries: 5
    networks:
      - intellilect-net

  gateway:
    image: nginx:latest
    container_name: intellilect-gateway
    volumes:
      - ./nginx.conf:/etc/nginx/nginx.conf:ro
    ports:
      - "80:80"
    depends_on:
      - user-service
    networks:
      - intellilect-net

networks:
  intellilect-net:
    driver: bridge

volumes:
  user_db_data:
</file>

<file path="nginx.conf">
worker_processes 1;

events { 
    worker_connections 1024; 
}

http {
    sendfile on;

    upstream user_service {
        server user-service:8080;
    }

    server {
        listen 80;

        # Unified API Route
        # This will now cover /api/auth, /api/users, and /api/admin
        location /api/ {
            proxy_pass         http://user_service/api/;
            proxy_set_header   Host $host;
            proxy_set_header   X-Real-IP $remote_addr;
            proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;
        }

        # 2. Scalar UI
        location /scalar {
            proxy_pass         http://user_service;
            proxy_set_header   Host $host;
        }

        # 3. OpenAPI Docs
        location /openapi {
            proxy_pass         http://user_service;
            proxy_set_header   Host $host;
        }

        # 4. Gateway Health
        location /health {
            return 200 'Gateway is alive';
            add_header Content-Type text/plain;
        }
    }
}
</file>

