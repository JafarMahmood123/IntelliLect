<file path="UserManagementService/src/UserManagementService.Infrastructure/Messaging/MassTransitEventBus.cs">
using MassTransit;
using UserManagementService.Application.Abstractions;

namespace UserManagementService.Infrastructure.Messaging;

public sealed class MassTransitEventBus : IEventBus
{
    private readonly IPublishEndpoint _publishEndpoint;

    public MassTransitEventBus(IPublishEndpoint publishEndpoint)
    {
        _publishEndpoint = publishEndpoint;
    }

    public async Task PublishAsync<T>(T message, CancellationToken ct = default)
        where T : class
    {
        await _publishEndpoint.Publish(message, ct);
    }
}
