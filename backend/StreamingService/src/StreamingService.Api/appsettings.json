{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "SecretKey": "",
    "Issuer": "",
    "Audience": ""
  },
  "LiveKit": {
    "ApiKey": "devkey",
    "ApiSecret": "super_secret_livekit_key_for_development",
    "Host": "ws://livekit-server:7880",
    "ApiUrl": "http://livekit-server:7880",
    "BucketName": "intellilect-files"
  },
  "LiveAssistant": {
    "BaseUrl": "http://live-assistant-service:8080",
    "InternalApiSecret": "",
    "TimeoutSeconds": 5
  },
  "Egress": {
    "Enabled": true,
    "KeyTemplate": "recordings/{room_name}/{time}.mp4",
    "S3": {
      "Bucket": "intellilect-files",
      "Region": "us-east-1",
      "AccessKey": "testuser",
      "Secret": "testpassword123!",
      "Endpoint": "http://intellilect-s3:9000"
    }
  },
  "//Media": [
    "LiveKit CLIENT settings, sent to the browser with the join token. See MediaOptions.cs for why",
    "each value is what it is — three of them must not be changed without reading the reasons.",
    "DO NOT CHANGE: Dtx and StopMicTrackOnMute feed the AI assistant's audio frame stream and its",
    "pause detection. Simulcast is what AdaptiveStream selects from.",
    "DEFERRED: AudioPreset -> 'speech' only after STT is verified (an SFU forwards this exact audio",
    "to the transcriber). VideoCodec -> 'h264' only after testing Firefox/Safari simulcast."
  ],
  "Media": {
    "AdaptiveStream": true,
    "Dynacast": true,
    "Simulcast": true,
    "VideoCodec": "vp8",
    "AudioPreset": "music",
    "Dtx": true,
    "Red": true,
    "StopMicTrackOnMute": false,
    "VideoWidth": 1280,
    "VideoHeight": 720,
    "VideoFramerate": 30,
    "ScreenShareWidth": 1920,
    "ScreenShareHeight": 1080,
    "ScreenShareFramerate": 5,
    "ScreenShareMaxBitrate": 1200000,
    "MaxRetries": 5,
    "PeerConnectionTimeoutMs": 15000,
    "WebsocketTimeoutMs": 15000
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"]
  }
}
