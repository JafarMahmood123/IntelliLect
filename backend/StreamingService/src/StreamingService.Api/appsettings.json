{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "SecretKey": "",
    "Issuer": "",
    "Audience": ""
  },
  "LiveKit": {
    "ApiKey": "devkey",
    "ApiSecret": "super_secret_livekit_key_for_development",
    "Host": "ws://livekit-server:7880",
    "ApiUrl": "http://livekit-server:7880",
    "BucketName": "intellilect-files"
  },
  "LiveAssistant": {
    "BaseUrl": "http://live-assistant-service:8080",
    "InternalApiSecret": "",
    "TimeoutSeconds": 5
  },
  "Egress": {
    "Enabled": true,
    "KeyTemplate": "recordings/{room_name}/{time}.mp4",
    "S3": {
      "Bucket": "intellilect-files",
      "Region": "us-east-1",
      "AccessKey": "testuser",
      "Secret": "testpassword123!",
      "Endpoint": "http://intellilect-s3:9000"
    }
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"]
  }
}
