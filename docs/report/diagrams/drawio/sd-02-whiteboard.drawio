        <mxCell id="m10" value="publishData(encode({t: &quot;pts&quot;, id, p}), {topic: &quot;wb&quot;, reliable: true})" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;rounded=0;fontSize=13;strokeColor=#000000;" edge="1" parent="1">
