  <diagram name="SD 4 - Compose, Edit and Publish a Quiz">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="2260" math="0" shadow="0">
