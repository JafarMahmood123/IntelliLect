#############################################
# OS
#############################################
.DS_Store
Thumbs.db

#############################################
# Visual Studio / .NET
#############################################
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.txt
# Demo material is the exception: it must be committed to be usable in a demo, and
# the course-notes file has to stay a real .txt because uploading it is what
# exercises the knowledge base's plain-text extractor.
!backend/docs/demo/*.txt
*.sln merge=union

appsettings.Development.json

bin/
obj/
[Dd]ebug/
[Rr]elease/

App_Data/
TestResults/
*.cache

#############################################
# Rider / JetBrains
#############################################
.idea/
*.iml
out/

#############################################
# VS Code
#############################################
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

#############################################
# Node / React
#############################################
node_modules/

# build output folders (varies by React tooling)
build/
dist/
out/

# Next.js (if you use it)
.next/

# Coverage
coverage/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Env files (keep local secrets out of git)
.env
.env.*
# ...but the EXAMPLES are documentation and must be committed. Without these negations
# `.env.*` above (and `*.env` further down) swallows them, and `git add .env.example`
# silently does nothing — no error, no file.
!.env.example
!*.env.example
.npmrc

#############################################
# Flutter
#############################################
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/

# Flutter pub cache (local dev)
.pub-cache/

#############################################
# Docker / Compose
#############################################
docker-compose.override.yml
*.env
!*.env.example

#############################################
# General
#############################################
# Avoid committing tool state / generated artifacts accidentally.
*.swp
*.swo
*.tmp

.cursor
.claude
.vscode
# Python bytecode and caches — the code-jury spec requires generated cache
# files be excluded from the repository.
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

#############################################
# Test-result artifacts (docs/testing-results.md §2)
#############################################
# Read by backend/tests/e2e/collect_results.py to generate the inventory table.
# Produced by a run, never committed — a checked-in count is the transcription
# problem again, one directory further away.
test-results.xml
*.trx

# Playwright (§11.12): its JUnit file, its HTML report, and the traces/screenshots/videos it
# keeps for failures. All of it is produced by a run and some of it is large.
playwright-results.xml
playwright-report/
test-results/
/front-end-web/.playwright/
